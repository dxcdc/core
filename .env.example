# =====================================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE - CDC CORE
# Copie este arquivo para '.env' no servidor e preencha as credenciais.
# NUNCA ENVIE O ARQUIVO '.env' COM CHAVES REAIS PARA O GIT!
# =====================================================================

# CONFIGURAÇÕES GERAIS DA APLICAÇÃO DJANGO
SECRET_KEY=sua_chave_secreta_django_aqui_gerada_com_segurança
DEBUG=False
ALLOWED_HOSTS=core.cdc.org.br,*.cdc.org.br,localhost,127.0.0.1

# 1. ☁️ GOOGLE WORKSPACE SDK (ADMIN SDK & DRIVE API)
GOOGLE_DELEGATED_ADMIN_EMAIL=dxcdc@cdc.org.br
GOOGLE_SERVICE_ACCOUNT_FILE=/app/credentials/google_service_account.json
GOOGLE_WORKSPACE_CUSTOMER_ID=my_customer

# 2. 📱 WHATSAPP EVOLUTION API
EVOLUTION_API_URL=https://whatsapp.cdc.org.br
EVOLUTION_API_KEY=sua_chave_secret_evolution_api_aqui
EVOLUTION_INSTANCE_NAME=cdc_bot_prod

# 3. 🏢 ONGSYS API v1
ONGSYS_SUBDOMAIN=cdc.ongsys.com.br
ONGSYS_APP_TOKEN=seu_app_access_token_ongsys_aqui

# 4. 📜 SEFAZ & FISCAL NF-e (CERTIFICADO A1)
SEFAZ_CERTIFICATE_PATH=/app/credentials/certificado_a1.pfx
SEFAZ_CERTIFICATE_PASSWORD=sua_senha_do_certificado_a1
SEFAZ_ENVIRONMENT=homologacao

# 5. 🔒 VPN WIREGUARD REST API
WIREGUARD_API_URL=https://vpn.cdc.org.br:51820
WIREGUARD_SECRET_KEY=sua_chave_secreta_wireguard_aqui

# 6. 🛢️ POSTGRESQL & VAULT
DATABASE_URL=postgres://usuario:senha@db.internal.cdc.org.br:5432/cdc_core_db
VAULT_ENCRYPTION_KEY=sua_chave_aes256_do_cofre_aqui

# 7. NEXTERP ANALYTICS API (USUÁRIO TÉCNICO SOMENTE LEITURA)
NEXTERP_BASE_URL=https://erp.cdc.org.br
NEXTERP_API_KEY=chave_do_usuario_tecnico_core
NEXTERP_API_SECRET=segredo_do_usuario_tecnico_core
NEXTERP_CONNECT_TIMEOUT=5
NEXTERP_READ_TIMEOUT=30
NEXTERP_MAX_RETRIES=3
